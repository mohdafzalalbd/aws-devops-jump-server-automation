# ==================================================
# AWS CONFIGURATION
# ==================================================

AWS_PROFILE=default
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1

# ==================================================
# PROJECT CONFIGURATION
# Match these values with terraform.tfvars
# ==================================================

PROJECT_NAME=my-devops-lab
ENVIRONMENT=learning
JUMP_SERVER_NAME=my-devops-lab-learning-jump-server

# ==================================================
# ANSIBLE AWS SSM CONFIGURATION
# ==================================================

# Create your own S3 bucket in your AWS account.
# The bucket should be in the same AWS region as EC2.
# Replace the placeholder before running Ansible.

ANSIBLE_AWS_SSM_BUCKET_NAME=YOUR_UNIQUE_S3_BUCKET_NAME
